rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/attempts/{roundId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validAttempt() {
        let d = request.resource.data;
        return d.keys().hasAll(['schemaVersion', 'variant', 'categoryId',
                 'questionCount', 'correctCount', 'submittedAt'])
          && d.keys().hasOnly(['schemaVersion', 'variant', 'categoryId',
                 'questionCount', 'correctCount', 'submittedAt'])
          && d.schemaVersion is int && d.schemaVersion == 1
          && d.variant == 'B'
          && d.categoryId is int && d.categoryId == 17
          && d.questionCount is int && d.questionCount == 5
          && d.correctCount is int
          && d.correctCount >= 0 && d.correctCount <= 5
          && d.submittedAt is timestamp
          && d.submittedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && validAttempt();
      allow update, delete: if false;
    }
  }
}